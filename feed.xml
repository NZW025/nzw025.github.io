 &lt;audio id="aud" src="https://www.joy127.com/url/144551.mp3" autoplay="1" loop=""&gt;&lt;/audio&gt;
	&lt;/body&gt;</description></item><item><title>人间共鸣</title><link>https://nzw025.top/qianxushiguang/yinhua/renjiangongming/</link><pubDate>Fri, 20 Feb 2026 17:00:27 +0800</pubDate><guid>https://nzw025.top/qianxushiguang/yinhua/renjiangongming/</guid><description>&lt;body&gt;
 &lt;DIV class="full-width" style="POSITION: relative; WIDTH: 1600px; TOP: 120px; LEFT: -250px"&gt;&lt;IFRAME height=900 marginHeight=0 src="http://cccimg.com/view.php/ddbe14fbadd6b581aebd598ea6d5313a.webp" frameBorder=0 width=1600 marginWidth=0 scrolling=no&gt;&lt;/IFRAME&gt;&lt;/DIV&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;
