/* 基础样式 */
.sentence-item {
 margin-bottom: 12px;
 margin-left: 6px;
 cursor: pointer;
 line-height: 1.6;
}
.sentence-number {
 font-weight: bold;
 color: #2c3e50; 
 user-select: none; 
 padding: 2px 4px;
 border-radius: 2px;
}
.sentence-number:hover {
 background-color: #f5f7fa; 
}
.cn-sentence {
 margin-left: 4px;
}
.en-sentence {
 display: none;
 margin-left: 42px; 
 color: #666; 
 margin-top: 4px;
}
.sentence-item.active .en-sentence {
 display: block;
}
.study-title {
 font-size: 18px;
 font-weight: bold;
 color: var(--color-title);
 margin: 20px 0 10px 0;
 border-bottom: 1px dashed var(--color-border);
 padding-bottom: 5px;
}
&lt;/style&gt;
&lt;div class="sentence-list"&gt;
&lt;div class="study-title"&gt;一. content（名词）相关&lt;/div&gt;
&lt;div class="sentence-item"&gt;
 &lt;span class="sentence-number"&gt;01&lt;/span&gt;&lt;span class="cn-sentence"&gt;. 他脸上露出了满意的神情。&lt;/span&gt;
 &lt;div class="en-sentence"&gt;Content showed on his face.&lt;/div&gt;
&lt;/div&gt;
&lt;div class="sentence-item"&gt;
 &lt;span class="sentence-number"&gt;02&lt;/span&gt;&lt;span class="cn-sentence"&gt;. 小小的成功带来了满足感。&lt;/span&gt;
 &lt;div class="en-sentence"&gt;Small success brings a sense of content.&lt;/div&gt;
&lt;/div&gt;
&lt;div class="sentence-item"&gt;
 &lt;span class="sentence-number"&gt;03&lt;/span&gt;&lt;span class="cn-sentence"&gt;. 内心的平静是一种高层次的满意。&lt;/span&gt;
 &lt;div class="en-sentence"&gt;Inner peace is a high - level content.&lt;/div&gt;
&lt;/div&gt;
&lt;div class="study-title"&gt;二. satisfaction（名词）相关&lt;/div&gt;
&lt;div class="sentence-item"&gt;
 &lt;span class="sentence-number"&gt;04&lt;/span&gt;&lt;span class="cn-sentence"&gt;. 顾客的满意是我们的目标。&lt;/span&gt;
 &lt;div class="en-sentence"&gt;Customer satisfaction is our goal.&lt;/div&gt;
&lt;/div&gt;
&lt;div class="sentence-item"&gt;
 &lt;span class="sentence-number"&gt;05&lt;/span&gt;&lt;span class="cn-sentence"&gt;. 他从工作中获得了极大的满意。&lt;/span&gt;
 &lt;div class="en-sentence"&gt;He derives great satisfaction from his job.&lt;/div&gt;
&lt;/div&gt;
&lt;div class="sentence-item"&gt;
 &lt;span class="sentence-number"&gt;06&lt;/span&gt;&lt;span class="cn-sentence"&gt;. 完成任务给她带来了满意。&lt;/span&gt;
 &lt;div class="en-sentence"&gt;Completing the task brought her satisfaction.&lt;/div&gt;
&lt;/div&gt;
&lt;div class="study-title"&gt;三. satisfied（形容词）相关&lt;/div&gt;
&lt;div class="sentence-item"&gt;
 &lt;span class="sentence-number"&gt;07&lt;/span&gt;&lt;span class="cn-sentence"&gt;. 他对新手机很满意。&lt;/span&gt;
 &lt;div class="en-sentence"&gt;He is satisfied with the new mobile phone.&lt;/div&gt;
&lt;/div&gt;
&lt;div class="sentence-item"&gt;
 &lt;span class="sentence-number"&gt;08&lt;/span&gt;&lt;span class="cn-sentence"&gt;. 她满意地看着自己的画作。&lt;/span&gt;
 &lt;div class="en-sentence"&gt;She looked at her painting with a satisfied expression.&lt;/div&gt;
&lt;/div&gt;
&lt;div class="sentence-item"&gt;
 &lt;span class="sentence-number"&gt;09&lt;/span&gt;&lt;span class="cn-sentence"&gt;. 我对这次购物非常满意。&lt;/span&gt;
 &lt;div class="en-sentence"&gt;I'm very satisfied with this shopping.&lt;/div&gt;
&lt;/div&gt;
&lt;div class="study-title"&gt;四. content（形容词）相关&lt;/div&gt;
&lt;div class="sentence-item"&gt;
 &lt;span class="sentence-number"&gt;10&lt;/span&gt;&lt;span class="cn-sentence"&gt;. 他对目前的生活状况很满意。&lt;/span&gt;
 &lt;div class="en-sentence"&gt;He is content with his current living condition.&lt;/div&gt;
&lt;/div&gt;
&lt;div class="sentence-item"&gt;
 &lt;span class="sentence-number"&gt;11&lt;/span&gt;&lt;span class="cn-sentence"&gt;. 老人过着满意而宁静的生活。&lt;/span&gt;
 &lt;div class="en-sentence"&gt;The old man lives a content and peaceful life.&lt;/div&gt;
&lt;/div&gt;
&lt;div class="sentence-item"&gt;
 &lt;span class="sentence-number"&gt;12&lt;/span&gt;&lt;span class="cn-sentence"&gt;. 她脸上总是带着满意的微笑。&lt;/span&gt;
 &lt;div class="en-sentence"&gt;She always has a content smile on her face.&lt;/div&gt;
&lt;/div&gt;
&lt;div class="study-title"&gt;五. pleased（形容词）相关&lt;/div&gt;
&lt;div class="sentence-item"&gt;
 &lt;span class="sentence-number"&gt;13&lt;/span&gt;&lt;span class="cn-sentence"&gt;. 老师对学生的表现很满意。&lt;/span&gt;
 &lt;div class="en-sentence"&gt;The teacher is pleased with the students' performance.&lt;/div&gt;
&lt;/div&gt;
&lt;div class="sentence-item"&gt;
 &lt;span class="sentence-number"&gt;14&lt;/span&gt;&lt;span class="cn-sentence"&gt;. 他满意地接受了这个礼物。&lt;/span&gt;
 &lt;div class="en-sentence"&gt;He accepted the gift with a pleased look.&lt;/div&gt;
&lt;/div&gt;
&lt;div class="sentence-item"&gt;
 &lt;span class="sentence-number"&gt;15&lt;/span&gt;&lt;span class="cn-sentence"&gt;. 她对新发型非常满意。&lt;/span&gt;
 &lt;div class="en-sentence"&gt;She is very pleased with her new hairstyle.&lt;/div&gt;
&lt;/div&gt;
&lt;div class="study-title"&gt;六. satisfy（动词）相关&lt;/div&gt;
&lt;div class="sentence-item"&gt;
 &lt;span class="sentence-number"&gt;16&lt;/span&gt;&lt;span class="cn-sentence"&gt;. 这份工作能满足他的需求。&lt;/span&gt;
 &lt;div class="en-sentence"&gt;This job can satisfy his needs.&lt;/div&gt;
&lt;/div&gt;
&lt;div class="sentence-item"&gt;
 &lt;span class="sentence-number"&gt;17&lt;/span&gt;&lt;span class="cn-sentence"&gt;. 美味的食物满足了他的味蕾。&lt;/span&gt;
 &lt;div class="en-sentence"&gt;The delicious food satisfied his taste buds.&lt;/div&gt;
&lt;/div&gt;
&lt;div class="sentence-item"&gt;
 &lt;span class="sentence-number"&gt;18&lt;/span&gt;&lt;span class="cn-sentence"&gt;. 我们努力满足客户的要求。&lt;/span&gt;
 &lt;div class="en-sentence"&gt;We try hard to satisfy the requirements of the clients.&lt;/div&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;script&gt;
document.addEventListener('DOMContentLoaded', function() {
 const sentenceItems = document.querySelectorAll('.sentence-item');
 sentenceItems.forEach(item =&gt; {
 const numberElement = item.querySelector('.sentence-number');
 numberElement.addEventListener('click', function() {
 item.classList.toggle('active');
 });
 item.addEventListener('click', function(e) {
 if (e.target !== numberElement) {
 item.classList.toggle('active');
 }
 });
 });
});
&lt;/script&gt;</description></item><item><title>情绪之愤怒</title><link>https://nzw025.top/jingxinyanxue/xiezuo/anger/</link><pubDate>Sun, 15 Feb 2026 18:13:27 +0800</pubDate><guid>https://nzw025.top/jingxinyanxue/xiezuo/anger/</guid><description>&lt;style&gt;
/* 基础样式 */
.sentence-item {
 margin-bottom: 12px;
 margin-left: 6px;
 cursor: pointer;
 line-height: 1.6;
}
.sentence-number {
 font-weight: bold;
 color: #2c3e50; 
 user-select: none; 
 padding: 2px 4px;
 border-radius: 2px;
}
.sentence-number:hover {
 background-color: #f5f7fa; 
}
.cn-sentence {
 margin-left: 4px;
}
.en-sentence {
 display: none;
 margin-left: 42px; 
 color: #666; 
 margin-top: 4px;
}
.sentence-item.active .en-sentence {
 display: block;
}
.study-title {
 font-size: 18px;
 font-weight: bold;
 color: var(--color-title);
 margin: 20px 0 10px 0;
 border-bottom: 1px dashed var(--color-border);
 padding-bottom: 5px;
}
&lt;/style&gt;
&lt;div class="sentence-list"&gt;
&lt;div class="study-title"&gt;一. anger相关&lt;/div&gt;
&lt;div class="sentence-item"&gt;
 &lt;span class="sentence-number"&gt;01&lt;/span&gt;&lt;span class="cn-sentence"&gt;. 他的话里充满了愤怒。&lt;/span&gt;
 &lt;div class="en-sentence"&gt;There was much anger in his words.&lt;/div&gt;
&lt;/div&gt;
&lt;div class="sentence-item"&gt;
 &lt;span class="sentence-number"&gt;02&lt;/span&gt;&lt;span class="cn-sentence"&gt;. 她试图掩饰自己的愤怒。&lt;/span&gt;
 &lt;div class="en-sentence"&gt;She tried to hide her anger.&lt;/div&gt;
&lt;/div&gt;
&lt;div class="study-title"&gt;二. rage相关&lt;/div&gt;
&lt;div class="sentence-item"&gt;
 &lt;span class="sentence-number"&gt;03&lt;/span&gt;&lt;span class="cn-sentence"&gt;. 他的暴怒让周围的人害怕。&lt;/span&gt;
 &lt;div class="en-sentence"&gt;His rage frightened the people around him.&lt;/div&gt;
&lt;/div&gt;
&lt;div class="sentence-item"&gt;
 &lt;span class="sentence-number"&gt;04&lt;/span&gt;&lt;span class="cn-sentence"&gt;. 她在暴怒中摔碎了花瓶。&lt;/span&gt;
 &lt;div class="en-sentence"&gt;She smashed the vase in a rage.&lt;/div&gt;
&lt;/div&gt;
&lt;div class="study-title"&gt;三. madness相关&lt;/div&gt;
&lt;div class="sentence-item"&gt;
 &lt;span class="sentence-number"&gt;05&lt;/span&gt;&lt;span class="cn-sentence"&gt;. 战争的残酷会带来疯狂。&lt;/span&gt;
 &lt;div class="en-sentence"&gt;The cruelty of war can bring madness.&lt;/div&gt;
&lt;/div&gt;
&lt;div class="sentence-item"&gt;
 &lt;span class="sentence-number"&gt;06&lt;/span&gt;&lt;span class="cn-sentence"&gt;. 他在疯狂中做出了错误决定。&lt;/span&gt;
 &lt;div class="en-sentence"&gt;He made a wrong decision in madness.&lt;/div&gt;
&lt;/div&gt;
&lt;div class="study-title"&gt;四. fury相关&lt;/div&gt;
&lt;div class="sentence-item"&gt;
 &lt;span class="sentence-number"&gt;07&lt;/span&gt;&lt;span class="cn-sentence"&gt;. 他的眼睛里闪烁着狂怒。&lt;/span&gt;
 &lt;div class="en-sentence"&gt;There was fury in his eyes.&lt;/div&gt;
&lt;/div&gt;
&lt;div class="sentence-item"&gt;
 &lt;span class="sentence-number"&gt;08&lt;/span&gt;&lt;span class="cn-sentence"&gt;. 敌人的攻击激起了我们的狂怒。&lt;/span&gt;
 &lt;div class="en-sentence"&gt;The enemy's attack aroused our fury.&lt;/div&gt;
&lt;/div&gt;
&lt;div class="study-title"&gt;五. angry相关&lt;/div&gt;
&lt;div class="sentence-item"&gt;
 &lt;span class="sentence-number"&gt;09&lt;/span&gt;&lt;span class="cn-sentence"&gt;. 他因为迟到而生气。&lt;/span&gt;
 &lt;div class="en-sentence"&gt;He is angry because he is late.&lt;/div&gt;
&lt;/div&gt;
&lt;div class="sentence-item"&gt;
 &lt;span class="sentence-number"&gt;10&lt;/span&gt;&lt;span class="cn-sentence"&gt;. 妈妈生气地看着调皮的孩子。&lt;/span&gt;
 &lt;div class="en-sentence"&gt;Mother looked at the naughty child angrily.&lt;/div&gt;
&lt;/div&gt;
&lt;div class="study-title"&gt;六. annoyed相关&lt;/div&gt;
&lt;div class="sentence-item"&gt;
 &lt;span class="sentence-number"&gt;11&lt;/span&gt;&lt;span class="cn-sentence"&gt;. 他对持续的噪音感到气恼。&lt;/span&gt;
 &lt;div class="en-sentence"&gt;He is annoyed by the continuous noise.&lt;/div&gt;
&lt;/div&gt;
&lt;div class="sentence-item"&gt;
 &lt;span class="sentence-number"&gt;12&lt;/span&gt;&lt;span class="cn-sentence"&gt;. 她因被误解而气恼不已。&lt;/span&gt;
 &lt;div class="en-sentence"&gt;She is extremely annoyed by being misunderstood.&lt;/div&gt;
&lt;/div&gt;
&lt;div class="study-title"&gt;七. enraged相关&lt;/div&gt;
&lt;div class="sentence-item"&gt;
 &lt;span class="sentence-number"&gt;13&lt;/span&gt;&lt;span class="cn-sentence"&gt;. 不公平的对待让他暴怒。&lt;/span&gt;
 &lt;div class="en-sentence"&gt;He was enraged by the unfair treatment.&lt;/div&gt;
&lt;/div&gt;
&lt;div class="sentence-item"&gt;
 &lt;span class="sentence-number"&gt;14&lt;/span&gt;&lt;span class="cn-sentence"&gt;. 看到破坏的场景他暴怒起来。&lt;/span&gt;
 &lt;div class="en-sentence"&gt;He became enraged when seeing the scene of destruction.&lt;/div&gt;
&lt;/div&gt;
&lt;div class="study-title"&gt;八. irritated相关&lt;/div&gt;
&lt;div class="sentence-item"&gt;
 &lt;span class="sentence-number"&gt;15&lt;/span&gt;&lt;span class="cn-sentence"&gt;. 频繁的打扰让他恼怒。&lt;/span&gt;
 &lt;div class="en-sentence"&gt;He is irritated by the frequent interruptions.&lt;/div&gt;
&lt;/div&gt;
&lt;div class="sentence-item"&gt;
 &lt;span class="sentence-number"&gt;16&lt;/span&gt;&lt;span class="cn-sentence"&gt;. 她因计划被打乱而恼怒。&lt;/span&gt;
 &lt;div class="en-sentence"&gt;She is irritated because the plan is disrupted.&lt;/div&gt;
&lt;/div&gt;
&lt;div class="study-title"&gt;九. mad相关&lt;/div&gt;
&lt;div class="sentence-item"&gt;
 &lt;span class="sentence-number"&gt;17&lt;/span&gt;&lt;span class="cn-sentence"&gt;. 他在堵车时抓狂得大喊。&lt;/span&gt;
 &lt;div class="en-sentence"&gt;He shouted madly during the traffic jam.&lt;/div&gt;
&lt;/div&gt;
&lt;div class="sentence-item"&gt;
 &lt;span class="sentence-number"&gt;18&lt;/span&gt;&lt;span class="cn-sentence"&gt;. 考试失败让他抓狂。&lt;/span&gt;
 &lt;div class="en-sentence"&gt;He went mad because of failing the exam.&lt;/div&gt;
&lt;/div&gt;
&lt;div class="study-title"&gt;十. furious相关&lt;/div&gt;
&lt;div class="sentence-item"&gt;
 &lt;span class="sentence-number"&gt;19&lt;/span&gt;&lt;span class="cn-sentence"&gt;. 他对这个结果狂怒不已。&lt;/span&gt;
 &lt;div class="en-sentence"&gt;He is furious about the result.&lt;/div&gt;
&lt;/div&gt;
&lt;div class="sentence-item"&gt;
 &lt;span class="sentence-number"&gt;20&lt;/span&gt;&lt;span class="cn-sentence"&gt;. 她因被欺骗而狂怒。&lt;/span&gt;
 &lt;div class="en-sentence"&gt;She is furious because she is deceived.&lt;/div&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;script&gt;
document.addEventListener('DOMContentLoaded', function() {
 const sentenceItems = document.querySelectorAll('.sentence-item');
 sentenceItems.forEach(item =&gt; {
 const numberElement = item.querySelector('.sentence-number');
 numberElement.addEventListener('click', function() {
 item.classList.toggle('active');
 });
